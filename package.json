{
  "name": "java-agent-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "build:site": "astro build",
    "index:search": "pagefind --site dist",
    "build": "npm run check && npm run build:site && npm run index:search",
    "preview": "npm run build && astro preview",
    "publish:day": "node scripts/publish-day.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "astro": "7.2.4",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "pagefind": "1.5.2",
    "playwright-core": "1.62.1",
    "typescript": "5.9.2"
  }
}
